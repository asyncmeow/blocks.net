<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2023.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Blocks.Net.DataTypes\Blocks.Net.DataTypes.csproj" />
      <ProjectReference Include="..\..\Utilities\Blocks.Net.Nbt\Blocks.Net.Nbt.csproj" />
      <ProjectReference Include="..\..\Utilities\Blocks.Net.Text\Blocks.Net.Text.csproj" />
      <ProjectReference Include="..\Blocks.Net.PacketSourceGenerator\Blocks.Net.PacketSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
      <None Remove="packets.json" />
      <AdditionalFiles Include="packets.json" />
    </ItemGroup>

</Project>
